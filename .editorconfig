dotnet_diagnostic.RA0028.severity = error # No base call in overriden function.
dotnet_diagnostic.RA0030.severity = warning # Consider using the non-generic variant of this method.
dotnet_diagnostic.RA0032.severity = error # Duplicate dependency field.
dotnet_diagnostic.RA0033.severity = error # Parameter forbids literal values.
dotnet_diagnostic.RA0037.severity = error # Prototypes should not be [NetSerializable].
dotnet_diagnostic.RA0038.severity = error # Prototypes should not be [Serializable].
dotnet_diagnostic.RA0039.severity = error # Do not instantiate prototypes directly.
dotnet_diagnostic.RA0042.severity = error # Redundant Prototype Type specification.
dotnet_diagnostic.RA0045.severity = warning # Use the proxy method.

dotnet_naming_rule.interfaces_rule.severity = warning
dotnet_naming_rule.type_parameters_rule.severity = warning
dotnet_naming_rule.types_rule.severity = warning
dotnet_naming_rule.methods_properties_events_rule.severity = warning
dotnet_naming_rule.local_functions_rule.severity = warning
dotnet_naming_rule.locals_and_parameters_rule.severity = warning
dotnet_naming_rule.public_fields_rule.severity = warning
dotnet_naming_rule.private_fields_rule.severity = warning
dotnet_naming_rule.private_constants_rule.severity = warning
dotnet_naming_rule.private_static_readonly_rule.severity = warning

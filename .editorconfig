dotnet_diagnostic.IDE0005.severity = warning # Unnecessary using directive.

# C# Compiler Warnings (CS)
dotnet_diagnostic.CS0067.severity = warning # An event was declared but never used in the class in which it was declared.
dotnet_diagnostic.CS0105.severity = error # The using directive for 'namespace' appeared previously in this namespace.
dotnet_diagnostic.CS0108.severity = error # A member was declared with the same name as a member in a base class. However, the new modifier was not used.
dotnet_diagnostic.CS0114.severity = error # A declaration in a class conflicts with a declaration in a base class such that the base class member will be hidden.
dotnet_diagnostic.CS0162.severity = warning # Unreachable code detected.
dotnet_diagnostic.CS0168.severity = warning # The variable 'var' is declared but never used.
dotnet_diagnostic.CS0169.severity = warning # The private field 'class member' is never used.
dotnet_diagnostic.CS0184.severity = error # The given expression is never of the provided ('type') type.
dotnet_diagnostic.CS0219.severity = warning # The variable 'variable' is assigned but its value is never used.
dotnet_diagnostic.CS0414.severity = warning # The private field 'field' is assigned but its value is never used.
dotnet_diagnostic.CS0419.severity = error # Ambiguous reference in cref attribute: 'Method Name1'. Assuming 'Method Name2', but could have also matched other overloads including 'Method Name3'.
dotnet_diagnostic.CS0612.severity = warning # The class designer marked a member with the Obsolete attribute. This means that the member might not be supported in a future version of the class.
dotnet_diagnostic.CS0618.severity = warning # A class member was marked with the Obsolete attribute, such that a warning will be issued when the class member is referenced. For more information, see Assembly level attributes.
dotnet_diagnostic.CS0628.severity = error # new protected member declared in sealed class
dotnet_diagnostic.CS0642.severity = warning # Possible mistaken empty statement.
dotnet_diagnostic.CS0649.severity = warning # Field 'field' is never assigned to, and will always have its default value 'value'.
dotnet_diagnostic.CS0672.severity = warning # Member 'member1' overrides obsolete member 'member2'. Add the Obsolete attribute to 'member1'.
dotnet_diagnostic.CS0809.severity = warning # Obsolete member 'member' overrides non-obsolete member 'member'.
dotnet_diagnostic.CS1570.severity = error # XML comment has badly formed XML.
dotnet_diagnostic.CS1571.severity = error # XML comment on 'construct' has a duplicate param tag for 'parameter'.
dotnet_diagnostic.CS1572.severity = error # XML comment has a param tag for 'parameter', but there is no parameter by that name.
dotnet_diagnostic.CS1573.severity = warning # Parameter 'parameter' has no matching param tag in the XML comment for 'parameter' (but other parameters do).
dotnet_diagnostic.CS1574.severity = error # XML comment has syntactically incorrect cref attribute 'name'.
dotnet_diagnostic.CS1584.severity = error # XML comment has syntactically incorrect cref attribute 'member'.
dotnet_diagnostic.CS1587.severity = error # XML comment is not placed on a valid language element.
dotnet_diagnostic.CS1591.severity = warning # Missing XML comment for publicly visible type or member 'Type_or_Member'.
dotnet_diagnostic.CS1658.severity = error # XML comment has a badly formed attribute.
dotnet_diagnostic.CS1711.severity = error # XML comment has a typeparam tag, but there is no type parameter by that name.
dotnet_diagnostic.CS1723.severity = error # XML comment has cref attribute 'attribute' that refers to a type parameter.
dotnet_diagnostic.CS1734.severity = error # XML comment has a paramref tag, but there is no parameter by that name.
dotnet_diagnostic.CS2008.severity = error # No source files specified. (Occurs when a project has no .cs files to compile)
dotnet_diagnostic.CS4014.severity = warning # Because this call is not awaited, execution of the current method continues before the call is completed.
dotnet_diagnostic.CS8019.severity = warning # Unnecessary using directive.
dotnet_diagnostic.CS8073.severity = warning # The result of the expression is always 'value' since a value of type 'type' is never equal to 'null'.
dotnet_diagnostic.CS8524.severity = warning # The switch expression does not handle some values of its input type (it is not exhaustive) involving an unnamed enum value.
dotnet_diagnostic.CS8892.severity = error # Method will not be used as an entry point because a synchronous entry point 'method' was found.
dotnet_diagnostic.CS9107.severity = error # Parameter is captured into the state of the enclosing type and its value is also passed to the base constructor.

# Analyzer Warnings (RA)
dotnet_diagnostic.RA0003.severity = suggestion # Class must be explicitly marked as [Virtual], abstract, static or sealed.
dotnet_diagnostic.RA0022.severity = suggestion # AutoGenerateComponentPause has no fields.
dotnet_diagnostic.RA0026.severity = suggestion # Use of uncached static Regex function.
dotnet_diagnostic.RA0028.severity = suggestion # No base call in overriden function.
dotnet_diagnostic.RA0030.severity = suggestion # Consider using the non-generic variant of this method.
dotnet_diagnostic.RA0032.severity = suggestion # Duplicate dependency field.
dotnet_diagnostic.RA0033.severity = suggestion # Parameter forbids literal values.
dotnet_diagnostic.RA0037.severity = suggestion # Prototypes should not be [NetSerializable].
dotnet_diagnostic.RA0038.severity = suggestion # Prototypes should not be [Serializable].
dotnet_diagnostic.RA0039.severity = suggestion # Do not instantiate prototypes directly.
dotnet_diagnostic.RA0042.severity = suggestion # Redundant Prototype Type specification.
dotnet_diagnostic.RA0045.severity = suggestion # Use the proxy method.

#### C# Formatting Rules ####

csharp_new_line_before_catch = true
csharp_new_line_before_else = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = false
csharp_new_line_before_open_brace = all
csharp_new_line_between_query_expression_clauses = true

csharp_indent_braces = false
csharp_indent_switch_labels = true
xmldoc_indent_text = zeroindent

csharp_space_after_cast = false
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_after_comma = true
csharp_space_after_dot = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_semicolon_in_for_statement = true
csharp_space_around_binary_operators = before_and_after
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_before_comma = false
csharp_space_before_dot = false
csharp_space_before_open_square_brackets = false
csharp_space_before_semicolon_in_for_statement = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_between_square_brackets = false

csharp_preserve_single_line_blocks = true

#### Naming Styles ####

# 1. Styles
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_style.i_pascal_case.capitalization = pascal_case
dotnet_naming_style.i_pascal_case.required_prefix = I

dotnet_naming_style.t_pascal_case.capitalization = pascal_case
dotnet_naming_style.t_pascal_case.required_prefix = T

# 2. Symbols
dotnet_naming_style.namespace_case.capitalization = pascal_case
dotnet_naming_style.namespace_case.required_prefix = 

dotnet_naming_symbols.namespaces.applicable_kinds = namespace
dotnet_naming_symbols.namespaces.applicable_accessibilities = *

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_symbols.type_parameters.applicable_accessibilities = *

dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.types.applicable_accessibilities = *

dotnet_naming_symbols.methods_properties_events.applicable_kinds = method, property, event
dotnet_naming_symbols.methods_properties_events.applicable_accessibilities = *

dotnet_naming_symbols.local_functions.applicable_kinds = local_function
dotnet_naming_symbols.local_functions.applicable_accessibilities = *

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = local, parameter
dotnet_naming_symbols.locals_and_parameters.applicable_accessibilities = *

dotnet_naming_symbols.public_fields.applicable_kinds = field
dotnet_naming_symbols.public_fields.applicable_accessibilities = public, internal, protected, protected_internal, private_protected

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.required_modifiers = const
dotnet_naming_symbols.private_constants.applicable_accessibilities = private

dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private

# 3. Rules
dotnet_naming_rule.interfaces_rule.symbols = interfaces
dotnet_naming_rule.interfaces_rule.style = i_pascal_case
dotnet_naming_rule.interfaces_rule.severity = suggestion

dotnet_naming_rule.type_parameters_rule.symbols = type_parameters
dotnet_naming_rule.type_parameters_rule.style = t_pascal_case
dotnet_naming_rule.type_parameters_rule.severity = suggestion

dotnet_naming_rule.types_rule.symbols = types
dotnet_naming_rule.types_rule.style = pascal_case
dotnet_naming_rule.types_rule.severity = suggestion

dotnet_naming_rule.methods_properties_events_rule.symbols = methods_properties_events
dotnet_naming_rule.methods_properties_events_rule.style = pascal_case
dotnet_naming_rule.methods_properties_events_rule.severity = suggestion

dotnet_naming_rule.local_functions_rule.symbols = local_functions
dotnet_naming_rule.local_functions_rule.style = pascal_case
dotnet_naming_rule.local_functions_rule.severity = suggestion

dotnet_naming_rule.locals_and_parameters_rule.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_rule.style = camel_case
dotnet_naming_rule.locals_and_parameters_rule.severity = suggestion

dotnet_naming_rule.public_fields_rule.symbols = public_fields
dotnet_naming_rule.public_fields_rule.style = pascal_case
dotnet_naming_rule.public_fields_rule.severity = suggestion

dotnet_naming_rule.private_fields_rule.symbols = private_fields
dotnet_naming_rule.private_fields_rule.style = underscore_camel_case
dotnet_naming_rule.private_fields_rule.severity = suggestion

dotnet_naming_rule.private_constants_rule.symbols = private_constants
dotnet_naming_rule.private_constants_rule.style = pascal_case
dotnet_naming_rule.private_constants_rule.severity = suggestion

dotnet_naming_rule.private_static_readonly_rule.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly_rule.style = pascal_case
dotnet_naming_rule.private_static_readonly_rule.severity = suggestion

#### ReSharper Properties ####

resharper_braces_for_ifelse = required_for_multiline
resharper_csharp_wrap_arguments_style = chop_if_long
resharper_csharp_wrap_parameters_style = chop_if_long
resharper_keep_existing_attribute_arrangement = true
resharper_wrap_chained_binary_patterns = chop_if_long
resharper_wrap_chained_method_calls = chop_if_long
resharper_csharp_trailing_comma_in_multiline_lists = true
resharper_csharp_qualified_using_at_nested_scope = false
resharper_csharp_prefer_qualified_reference = false
resharper_csharp_allow_alias = false
resharper_csharp_place_simple_embedded_statement_on_same_line = never
resharper_csharp_keep_existing_embedded_arrangement = false

#### File Extension Rules ####

[*.{csproj,xml,yml,yaml,dll.config,msbuildproj,targets,props}]
indent_size = 2

[nuget.config]
indent_size = 2

[{*.yaml,*.yml}]
ij_yaml_indent_sequence_value = false


<Project>
  <!--Main Package Manifest Info.-->
  <PropertyGroup>
    <!--Project Information-->
    <Title>HardLight</Title>
    <Description>A multiplayer game about paranoia and chaos on a space station. Remake of the cult-classic Space Station 13. HardLight Fork.</Description>
    <Version>0.2.0</Version>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageLicenseUrl>https://code.hardlight.space/HardLight/HardLight/src/branch/master/LICENSE-AGPLv3.txt</PackageLicenseUrl>
    <Company>HardLight</Company>
    <Copyright>Copyright © 2026 HardLight</Copyright>
    <PackageTags>ss14;space-station-14;roleplay;erp;nsfw;18+;adults-only;hardlight</PackageTags>

    <!--Repo Info-->
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://code.hardlight.space/HardLight/HardLight</RepositoryUrl>
    <PackageProjectUrl>https://hardlight.space/</PackageProjectUrl>

    <!--Changelog-->
    <!-- Define the path relative to Directory.Build.props -->
    <ChangelogPath>$(MSBuildThisFileDirectory)Resources/Changelog/HardlightChangelog.yml</ChangelogPath>
    <!-- Read the file into the tag, but only if the file actually exists -->
    <PackageReleaseNotes Condition="Exists('$(ChangelogPath)')">$([System.IO.File]::ReadAllText('$(ChangelogPath)'))</PackageReleaseNotes>

    <!--Meta Files-->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon-256x256.png</PackageIcon>

    <!--Compiler Options-->
    <!--<LangVersion>latest</LangVersion> No point in putting this here, the csproj's define this.-->
    <!-- Enable modern C# features for the game, but exclude ancient utility tools -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ErrorReport>none</ErrorReport>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <!--Has to be in its own group guarded by a condition due to this being incompatible with pre-net8.0 versions.-->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'BuildChecker'">
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--Required Includes For Above Manifest-->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="Resources/Textures/_HL/Logo/icon/icon-256x256.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <_ProjectDir>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)'))</_ProjectDir>
    <_RobustToolboxDir>$([MSBuild]::EnsureTrailingSlash('$(MSBuildThisFileDirectory)RobustToolbox'))</_RobustToolboxDir>
    <_CefGlueDir>$([MSBuild]::EnsureTrailingSlash('$(MSBuildThisFileDirectory)RobustToolbox\cefglue'))</_CefGlueDir>
    <_IsRobustToolboxProject>$([System.String]::Copy('$(_ProjectDir)').StartsWith('$(_RobustToolboxDir)'))</_IsRobustToolboxProject>
    <_IsCefGlueProject>$([System.String]::Copy('$(_ProjectDir)').StartsWith('$(_CefGlueDir)'))</_IsCefGlueProject>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)RobustToolbox\cefglue\Directory.Build.props"
          Condition="'$(_IsCefGlueProject)' == 'True'" />

  <Import Project="$(MSBuildThisFileDirectory)RobustToolbox\Directory.Build.props"
          Condition="'$(_IsCefGlueProject)' != 'True' and '$(_IsRobustToolboxProject)' == 'True'" />

  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**;**/tmpbuild/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
uniform sampler2D SCREEN_TEXTURE;
uniform highp float strength;

void fragment() {
    // Shader code istn't gonna be great, I need more experience ngl.

    // Only activate static when whisp is in the final 20% of distance (80% - 100%)
    highp float ramp = clamp((strength - 0.8) / 0.2, 0.0, 1.0);

    if (ramp <= 0.0) {
        discard;
    }

    // Procedural static
    // Learned this off of looking up algorithms online
    highp vec2 seed = FRAGCOORD.xy * SCREEN_PIXEL_SIZE + vec2(fract(TIME * 60.0), fract(TIME * 23.0));
    highp vec2 noiseVal = zRandom(seed);
    highp float noise = noiseVal.x;

    // Horizontal scanline artifacts
    // Figured this out with lots of head beating the wall :P
    highp float scanline = sin(FRAGCOORD.y * 1.5 + TIME * 12.0) * 0.03 * ramp;
    highp vec3 staticRgb = vec3(noise) + scanline;

    // Alpha blend: smoothly ramps up from 0 to ~0.45 in the last 20%
    highp float alpha = ramp * 0.45;

    COLOR = vec4(staticRgb, alpha);
}
